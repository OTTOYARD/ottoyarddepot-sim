      }
    },
    {
      "area": "simulator_structure",
      "kind": "capability_gap",
      "weight": 1939,
      "finding": "Given what really happened, the simulator still puts a car's plug-in a mean 10.71 minutes from when it really plugged in (bias -3.67). It does not model bays, holds, the stall pick beyond the kind, or the next order taking over; that error no forecast can remove.",
      "evidence": {
        "missed": 447,
        "mae_min": 10.71,
        "phantom": 312,
        "bias_min": -3.67,
        "within_5_min": 0.549,
        "cars_compared": 1939
      }
    },
    {
      "area": "outflow_return_cycle",
      "kind": "capability_gap",
      "weight": 532,
      "finding": "8.72 cars per order came home inside the window that the check never saw coming; 532 of 532 had left after the order, a mean of 78.6 minutes before they came back. The simulator has no departures: a car that finishes its charge leaves, works its battery down to the reserve and rejoins the line inside the same window. Modelling the outflow (when ready cars leave) and the return at the learned reserve would let the check see them; its objective would then have to count a faster turnaround as a gain, not as more cars in the line.",
      "evidence": {
        "orders": 61,
        "per_order": 8.72,
        "by_trigger": {
          "comms_stale": 55,
          "low_soc_reserve": 467,
          "rider_flag_cleaning": 10
        },
        "left_before": 0,
        "mean_eta_min": 78.6,
        "appeared_returned": 532,
        "dispatch_not_found": 0,
        "left_after_the_order": 532
      }
    },
